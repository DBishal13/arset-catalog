{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dataset / data product",
  "type": "object",
  "required": ["id", "name"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string" },
    "short_name": { "type": "string", "description": "CMR / DAAC short name, when known." },
    "satellites": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "provider": { "type": "string", "description": "DAAC or archive that distributes it." },
    "variables": { "type": "array", "items": { "type": "string" } },
    "resolution": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "url": { "type": "string", "format": "uri" },
    "notes": { "type": "string" }
  }
}
